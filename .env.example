# Finex CLI — MT5 Trading Bot
# Salin file ini menjadi .env lalu isi dengan kredensial kamu:
#   cp .env.example .env
#
# PENTING: File .env sudah masuk .gitignore.
#          JANGAN pernah commit file .env ke repositori publik!

# ─── MT5 Connection ──────────────────────────────────────────────────────────

# Nama perusahaan / broker
FINEX_COMPANY=FinexBisnisSolusi

# Nomor login akun MT5 (angka)
FINEX_LOGIN=your_login_number

# Nama server MT5 (lihat di platform MetaTrader)
FINEX_SERVER=FinexBisnisSolusi-Demo

# Host dan port server MT5
FINEX_HOST=prod-mt5-demo1.fnx.xmt.mx:443

# Password akun MT5 — RAHASIA, jangan di-commit!
FINEX_PASSWORD=your_password

# ─── Telegram Bot (Opsional) ──────────────────────────────────────────────────
# Kosongkan kedua variabel ini jika tidak ingin menggunakan Telegram bot.
# Cara mendapatkan token: buat bot via @BotFather di Telegram.
# Cara mendapatkan Chat ID: kirim pesan ke @userinfobot.

# Token dari @BotFather
TELEGRAM_BOT_TOKEN=

# Chat ID kamu (angka, bisa negatif untuk grup)
TELEGRAM_CHAT_ID=
